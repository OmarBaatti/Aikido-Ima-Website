# SERVER ONLY — never expose these through Vite/public env variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
APP_USERNAME=review_admin
APP_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
PORT=3001
# In production behind Nginx, set this to your HTTPS origin, e.g. https://review.example.com
CORS_ORIGIN=https://aikidoima.com
NODE_ENV=production
